# 로컬 개발용 LocalDiskStorageProvider가 저장하는 실제 업로드 파일 (mkdir로 자동 생성됨,
# AWS_S3_BUCKET_NAME 미설정 시에만 사용됨 — backend/src/upload/upload.module.ts)
backend/uploads/

# Playwright — 실 계정 httpOnly 쿠키(storageState)는 절대 커밋하지 않는다
frontend/e2e/.auth/
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/

# Misc
.vercel
.turbo

legacy/

# CDKTF (infra/)
infra/cdktf.out/
infra/.gen/
infra/terraform.tfstate*
infra/.terraform/
infra/.terraform.lock.hcl
infra/*.tfplan

# Android 릴리즈 서명 키 — 절대 커밋하지 않는다 (mobile/libs/.gitignore와 이중 방어)
mobile/libs/*.jks
mobile/libs/*.keystore

# Firebase 서비스 계정 키 — 실제 프라이빗 키가 들어있어 절대 커밋하지 않는다.
# backend는 이 파일을 직접 읽지 않고 backend/.env의 FIREBASE_* 값으로 동작한다.
libs/firebase/serviceAccountKey.json