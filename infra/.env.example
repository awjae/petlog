# 권장: 실제 Access Key/Secret Key는 이 파일에 넣지 않는다.
# `aws configure --profile petlog`로 ~/.aws/credentials(레포 밖)에 저장하고,
# 여기에는 "어떤 프로필/리전을 쓸지"에 대한 비-시크릿 참조만 남긴다.
AWS_PROFILE=petlog
AWS_REGION=ap-northeast-2

# 대안: aws configure 없이 바로 쓰고 싶다면 위 두 줄을 지우고 아래처럼 직접 채운다.
# 이 방식은 시크릿이 레포 폴더 안에 남는다 — Claude Code 등 이 폴더를 읽는 도구가
# 실수로 값을 노출시킬 수 있으니, 값은 반드시 본인이 에디터로 직접 입력한다
# (채팅/AI 도구에 절대 붙여넣지 않는다).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-2
