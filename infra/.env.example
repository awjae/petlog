# 권장: 실제 Access Key/Secret Key는 이 파일에 넣지 않는다.
# `aws configure --profile petlog`로 ~/.aws/credentials(레포 밖)에 저장하고,
# 여기에는 "어떤 프로필/리전을 쓸지"에 대한 비-시크릿 참조만 남긴다.
AWS_PROFILE=petlog
AWS_REGION=ap-northeast-2

# 대안: aws configure 없이 바로 쓰고 싶다면 위 두 줄을 지우고 아래처럼 직접 채운다.
# 이 방식은 시크릿이 레포 폴더 안에 남는다 — Claude Code 등 이 폴더를 읽는 도구가
# 실수로 값을 노출시킬 수 있으니, 값은 반드시 본인이 에디터로 직접 입력한다
# (채팅/AI 도구에 절대 붙여넣지 않는다).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-2

# backend-stack 배포 시 주입할 TF_VAR_* (infra/README.md "백엔드 시크릿 채우기" 참고).
# 콘솔에서 수동으로 만든 뒤 CDKTF로 가져온(import) 리소스와 값이 일치해야 한다 —
# 어긋나면 다음 apply에서 실제 SES Identity/ACM 인증서가 재생성되려 할 수 있다.
# TF_VAR_mail_provider=ses
# SES에 도메인 단위로 Verified Identity를 등록한 발신 도메인. mail_provider=ses면 반드시 채운다
# (비워두면 SES Identity가 빈 문자열로 생성되려 해서 apply가 깨진다).
# TF_VAR_mail_from_domain=petlog.quest
# 위 도메인에 속하는 주소여야 한다 — 어긋나면 plan 단계에서 validation이 막는다.
# TF_VAR_mail_from_address=noreply@petlog.quest
# TF_VAR_domain_name=

# Sentry DSN — backend/frontend가 서로 다른 Sentry 프로젝트를 쓰면 값도 다르게 채운다.
# 비어있으면(기본값) 해당 스택은 Sentry를 비활성 상태로 배포한다.
# TF_VAR_backend_sentry_dsn=
# TF_VAR_frontend_sentry_dsn=
