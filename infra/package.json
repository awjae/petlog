{
  "name": "@petlog/infra",
  "version": "0.0.1",
  "private": true,
  "description": "Petlog AWS 인프라 정의 (CDKTF, TypeScript)",
  "scripts": {
    "postinstall": "cdktf get",
    "get": "cdktf get",
    "synth": "cdktf synth",
    "destroy": "dotenv -e .env -- cdktf destroy",
    "typecheck": "tsc --noEmit",
    "diff:bootstrap": "dotenv -e .env -- cdktf diff petlog-bootstrap",
    "deploy:bootstrap": "dotenv -e .env -- cdktf deploy petlog-bootstrap",
    "diff:all": "dotenv -e .env -v PETLOG_ENV=dev -- bash -c 'for s in petlog-registry-dev petlog-storage-dev petlog-network-dev petlog-database-dev petlog-backend-dev petlog-frontend-dev; do echo \"=== $s ===\"; cdktf diff $s --ignore-missing-stack-dependencies; done'",
    "deploy:all": "dotenv -e .env -v PETLOG_ENV=dev -- bash scripts/deploy.sh",
    "output:alb:url": "dotenv -e .env -- terraform -chdir=cdktf.out/stacks/petlog-backend-dev output -raw alb_url"
  },
  "dependencies": {
    "cdktf": "^0.21.0",
    "constructs": "^10.4.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "cdktf-cli": "^0.21.0",
    "typescript": "^5.4.5",
    "ts-node": "^10.9.2",
    "@types/node": "^22.0.0",
    "dotenv-cli": "^11.0.0"
  }
}
