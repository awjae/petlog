{
  "name": "@petlog/infra",
  "version": "0.0.1",
  "private": true,
  "description": "Petlog AWS 인프라 정의 (CDKTF, TypeScript)",
  "scripts": {
    "postinstall": "cdktf get",
    "get": "cdktf get",
    "synth": "cdktf synth",
    "diff": "dotenv -e .env -- cdktf diff",
    "deploy": "dotenv -e .env -- cdktf deploy",
    "destroy": "dotenv -e .env -- cdktf destroy",
    "typecheck": "tsc --noEmit",
    "diff:bootstrap": "dotenv -e .env -- cdktf diff petlog-bootstrap",
    "deploy:bootstrap": "dotenv -e .env -- cdktf deploy petlog-bootstrap",
    "diff:registry": "dotenv -e .env -v PETLOG_ENV=dev -- cdktf diff petlog-registry-dev",
    "deploy:registry": "dotenv -e .env -v PETLOG_ENV=dev -- cdktf deploy petlog-registry-dev",
    "diff:storage": "dotenv -e .env -v PETLOG_ENV=dev -- cdktf diff petlog-storage-dev",
    "deploy:storage": "dotenv -e .env -v PETLOG_ENV=dev -- cdktf deploy petlog-storage-dev",
    "diff:network": "dotenv -e .env -v PETLOG_ENV=dev -- cdktf diff petlog-network-dev",
    "deploy:network": "dotenv -e .env -v PETLOG_ENV=dev -- cdktf deploy petlog-network-dev",
    "diff:database": "dotenv -e .env -v PETLOG_ENV=dev -- cdktf diff petlog-database-dev",
    "deploy:database": "dotenv -e .env -v PETLOG_ENV=dev -- cdktf deploy petlog-database-dev",
    "diff:backend": "dotenv -e .env -v PETLOG_ENV=dev -- cdktf diff petlog-backend-dev",
    "deploy:backend": "dotenv -e .env -v PETLOG_ENV=dev -- cdktf deploy petlog-backend-dev",
    "deploy:backend:with-frontend-url": "dotenv -e .env -v PETLOG_ENV=dev -- bash -c 'export TF_VAR_frontend_url=\"https://$(terraform -chdir=cdktf.out/stacks/petlog-frontend-dev output -raw frontend_service_url)\"; cdktf deploy petlog-backend-dev'",
    "diff:frontend": "dotenv -e .env -v PETLOG_ENV=dev -- cdktf diff petlog-frontend-dev",
    "deploy:frontend": "dotenv -e .env -v PETLOG_ENV=dev -- cdktf deploy petlog-frontend-dev",
    "output:database": "dotenv -e .env -- terraform -chdir=cdktf.out/stacks/petlog-database-dev output",
    "output:backend": "dotenv -e .env -- terraform -chdir=cdktf.out/stacks/petlog-backend-dev output",
    "output:backend:url": "dotenv -e .env -- terraform -chdir=cdktf.out/stacks/petlog-backend-dev output -raw backend_service_url",
    "output:frontend": "dotenv -e .env -- terraform -chdir=cdktf.out/stacks/petlog-frontend-dev output",
    "output:frontend:url": "dotenv -e .env -- terraform -chdir=cdktf.out/stacks/petlog-frontend-dev output -raw frontend_service_url"
  },
  "dependencies": {
    "cdktf": "^0.21.0",
    "constructs": "^10.4.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "cdktf-cli": "^0.21.0",
    "typescript": "^5.4.5",
    "ts-node": "^10.9.2",
    "@types/node": "^22.0.0",
    "dotenv-cli": "^11.0.0"
  }
}
