{
  "name": "petlog",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "libs/types",
    "libs/utils",
    "libs/ai",
    "libs/storage",
    "backend",
    "frontend",
    "infra"
  ],
  "scripts": {
    "dev:libs": "tsc --build --watch libs/types libs/utils libs/ai libs/storage",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc --build && npm run typecheck --workspace=infra",
    "prepare": "husky",
    "infra:synth": "npm run synth --workspace=infra",
    "infra:diff": "npm run diff --workspace=infra",
    "infra:deploy": "npm run deploy --workspace=infra",
    "ecr:login": "aws ecr get-login-password --region ap-northeast-2 | docker login --username AWS --password-stdin 095256592046.dkr.ecr.ap-northeast-2.amazonaws.com",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f db",
    "db:migrate": "npm run db:up && npm run prisma:migrate --workspace=@petlog/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=@petlog/backend",
    "prisma:studio": "npm run prisma:studio --workspace=@petlog/backend"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.5"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "frontend/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "libs/**/*.ts": [
      "prettier --write"
    ],
    "infra/**/*.ts": [
      "prettier --write"
    ]
  }
}
