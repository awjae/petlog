generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pets                Pet[]
  notifications       Notification[]
  pushTokens          PushToken[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// ─── Pet ─────────────────────────────────────────────────────────────────────

model Pet {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  name            String
  species         Species
  breed           String?
  birthDate       DateTime? @map("birth_date")
  gender          Gender
  weight          Decimal?  @db.Decimal(5, 2)
  isNeutered      Boolean   @default(false) @map("is_neutered")
  profileImageUrl String?   @map("profile_image_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthRecords HealthRecord[]
  medicalEvents MedicalEvent[]
  medications   Medication[]
  vaccinations  Vaccination[]
  appointments  Appointment[]
  reports       Report[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@map("pets")
}

// ─── HealthRecord ─────────────────────────────────────────────────────────────

model HealthRecord {
  id         String           @id @default(uuid())
  petId      String           @map("pet_id")
  type       HealthRecordType
  numValue   Decimal?         @map("num_value") @db.Decimal(8, 2)
  textValue  String?          @map("text_value")
  note       String?
  recordedAt DateTime         @map("recorded_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  deletedAt  DateTime?        @map("deleted_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, recordedAt(sort: Desc)])
  @@index([petId, deletedAt])
  @@map("health_records")
}

// ─── MedicalEvent ────────────────────────────────────────────────────────────

model MedicalEvent {
  id             String    @id @default(uuid())
  petId          String    @map("pet_id")
  hospitalName   String    @map("hospital_name")
  visitDate      DateTime  @map("visit_date")
  description    String
  attachmentUrls String[]  @default([]) @map("attachment_urls")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, visitDate(sort: Desc)])
  @@index([petId, deletedAt])
  @@map("medical_events")
}

// ─── Medication ───────────────────────────────────────────────────────────────

model Medication {
  id        String    @id @default(uuid())
  petId     String    @map("pet_id")
  name      String?
  dosage    String?
  frequency String?
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([petId, endDate])
  @@index([petId, deletedAt])
  @@map("medications")
}

// ─── Vaccination ──────────────────────────────────────────────────────────────

model Vaccination {
  id           String    @id @default(uuid())
  petId        String    @map("pet_id")
  name         String
  code         String?
  vaccinatedAt DateTime  @map("vaccinated_at")
  nextDueAt    DateTime? @map("next_due_at")
  memo         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, vaccinatedAt(sort: Desc)])
  @@index([petId, nextDueAt])
  @@index([petId, deletedAt])
  @@map("vaccinations")
}

// ─── Appointment ──────────────────────────────────────────────────────────────

model Appointment {
  id           String            @id @default(uuid())
  petId        String            @map("pet_id")
  hospitalName String            @map("hospital_name")
  scheduledAt  DateTime          @map("scheduled_at")
  reason       String?
  status       AppointmentStatus @default(scheduled)
  memo         String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, scheduledAt(sort: Desc)])
  @@index([petId, deletedAt])
  @@map("appointments")
}

// ─── Report ───────────────────────────────────────────────────────────────────
// 비동기 생성 흐름: pending → processing → completed | failed
//
// 쿼터 정책: 반려동물 1마리당 월 1회 무료
//   - pending/processing 상태도 쿼터 소진으로 처리 (failed만 재시도 가능)
//   - 쿼터 조회 기준은 report.createdAt (사용자가 고른 periodStart/periodEnd가 아님)
//   - 쿼터 조회: pet_id + created_at 당월 범위 + status != 'failed'
//
// periodStart/periodEnd: 사용자가 캘린더에서 직접 지정한 분석 기간(7~90일)을 그대로 저장한다.
//
// Partial Unique Index 주의:
//   completed 상태에서만 동일 (petId, periodStart, periodEnd) 중복 방지.
//   @@unique 대신 migration.sql의 "reports_completed_period_unique_idx" 적용.
//
// period_end >= period_start CHECK 제약:
//   Prisma 6.19.3은 @@check를 지원하지 않아(schema validate 시 "Attribute not known: @check" 에러)
//   스키마에는 표현하지 않고 migration.sql의 ALTER TABLE ... ADD CONSTRAINT로만 적용한다.
//   (Postgres 레벨에서는 여전히 강제된다.)

model Report {
  id              String             @id @default(uuid())
  petId           String             @map("pet_id")
  status          ReportStatus       @default(pending)
  overview        String?
  highlights      String[]           @default([])
  concerns        String[]           @default([])
  recommendations String[]           @default([])
  generatedBy     ReportGeneratedBy? @map("generated_by")
  failedReason    String?            @map("failed_reason")
  periodStart     DateTime           @map("period_start")
  periodEnd       DateTime           @map("period_end")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  // @@unique 제거 — Partial Unique Index로 교체 (migration.sql 참조)
  @@index([petId, createdAt(sort: Desc)])
  @@map("reports")
}

// ─── PushToken ────────────────────────────────────────────────────────────────
// 기기별 FCM 토큰 — 한 사용자가 여러 기기를 쓸 수 있어 1:N

model PushToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ─── Notification ─────────────────────────────────────────────────────────────
// 발송된 알림 로그 — 인앱 알림 목록 표시 + 중복 발송 방지에 활용

model Notification {
  id            String                     @id @default(uuid())
  userId        String                     @map("user_id")
  type          NotificationType
  title         String
  body          String
  referenceId   String?                    @map("reference_id")
  referenceType NotificationReferenceType? @map("reference_type")
  sentAt        DateTime?                  @map("sent_at")
  readAt        DateTime?                  @map("read_at")
  createdAt     DateTime                   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

// ─── RefreshToken ─────────────────────────────────────────────────────────────
// 평문 저장 금지 — tokenHash(SHA-256)만 저장
// revokedAt이 null이고 expiresAt > now()인 경우만 유효

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── PasswordResetToken ───────────────────────────────────────────────────────
// 평문 저장 금지 — RefreshToken과 동일하게 tokenHash(SHA-256)만 저장, 원문은 이메일로만 전달.
//
// consumedAt vs revokedAt 구분:
//   - consumedAt: 실제 비밀번호 변경(POST)에 성공했을 때만 기록. 링크 열람/검증(GET성 조회)은
//     만료 여부만 확인할 뿐 이 값을 건드리지 않는다 — 이메일 클라이언트의 링크 프리페치가
//     토큰을 미리 소모시키는 문제를 방지하기 위함.
//   - revokedAt: 같은 사용자가 재요청(재전송)해 새 토큰을 발급받으면, 이전에 발급된 미사용
//     토큰들을 여기에 무효 처리 시각을 기록한다 (RefreshToken의 RTR 패턴과 동일 컨셉).
//
// 유효성 조건: consumedAt IS NULL AND revokedAt IS NULL AND expiresAt > now()
// 만료 시간: 30분 권장 (이메일 전달 지연 대비 사용성과 보안의 절충안, 필요 시 15분으로 축소 가능)
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Species {
  dog
  cat
}

enum Gender {
  male
  female
  unknown
}

enum HealthRecordType {
  weight
  appetite
  activity
  symptom
  stool
  vomit
  mood
}

enum ReportStatus {
  pending
  processing
  completed
  failed
}

enum ReportGeneratedBy {
  mock
  ai
}

enum AppointmentStatus {
  scheduled
  completed
  cancelled
}

enum NotificationType {
  appointmentReminder
  vaccinationDue
  medicationReminder
  weeklyCheckin
}

enum NotificationReferenceType {
  appointment
  vaccination
  medication
}
