{
  "name": "@petlog/backend",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:logs": "docker compose -f ../docker-compose.yml logs -f db",
    "deploy:check-version": "dotenv -e .env -- bash ../infra/scripts/check-version-not-deployed.sh petlog-backend",
    "deploy:ecr-login": "dotenv -e .env -- bash -c 'REGION=\"${AWS_REGION:-ap-northeast-2}\"; aws ecr get-login-password --region \"$REGION\" | docker login --username AWS --password-stdin \"$(aws sts get-caller-identity --query Account --output text).dkr.ecr.$REGION.amazonaws.com\"'",
    "deploy:build": "docker build -f Dockerfile -t petlog-backend ..",
    "deploy:ecr-push": "dotenv -e .env -- bash ../infra/scripts/ecr-push.sh petlog-backend petlog-backend",
    "deploy:refresh-database-url": "dotenv -e .env -- bash ../infra/scripts/refresh-database-url-ssm.sh",
    "deploy:ecs-force-redeploy": "dotenv -e .env -- bash -c 'REGION=\"${AWS_REGION:-ap-northeast-2}\"; ENV=\"${PETLOG_ENV:-dev}\"; aws ecs update-service --region \"$REGION\" --cluster \"petlog-cluster-$ENV\" --service \"petlog-backend-$ENV\" --force-new-deployment >/dev/null'",
    "deploy:image": "npm run deploy:check-version && npm run deploy:ecr-login && npm run deploy:build && npm run deploy:ecr-push && npm run deploy:refresh-database-url && npm run deploy:ecs-force-redeploy",
    "deploy": "npm run deploy:image",
    "migrate:deploy:ecs": "dotenv -e ../infra/.env -- bash scripts/migrate-deploy-ecs.sh",
    "seed:report-requirements": "ts-node -T scripts/seed-report-requirements.ts",
    "seed:report-history": "ts-node -T scripts/seed-report-history.ts",
    "seed:illness-symptoms": "ts-node -T scripts/seed-illness-symptoms.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^13.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@petlog/ai": "*",
    "@petlog/mail": "*",
    "@petlog/push": "*",
    "@petlog/storage": "*",
    "@prisma/client": "^6.0.0",
    "@sentry/node": "^10.67.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "file-type": "^22.0.1",
    "graphql": "^16.9.0",
    "openai": "^6.45.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2"
  }
}
