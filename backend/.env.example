NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/petlog

# JWT
JWT_SECRET=your-access-token-secret-here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here
REFRESH_TOKEN_EXPIRES_IN=30d

# App
PORT=4000
FRONTEND_URL=http://localhost:3000

# AWS S3 업로드 (비어있으면 로컬 디스크 저장(uploads/)을 사용한다)
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=
AWS_CLOUDFRONT_DOMAIN=

# OpenAI (비어있으면 MockHealthReportGenerator를 사용한다 — 로컬 개발 기본값)
OPENAI_API_KEY=

# AWS 자격 증명 (S3Client가 기본 자격 증명 체인으로 읽는다).
# 로컬에서 실제 S3 업로드를 테스트하거나 `npm run deploy`(ECR 로그인/push, ECS
# force-new-deployment)를 실행할 때만 필요하다 — 값은 반드시 본인이 직접 입력하고
# 채팅/AI 도구에는 절대 붙여넣지 않는다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 이메일 발송
# MAIL_PROVIDER=ses로 설정하고 AWS_REGION/MAIL_FROM_ADDRESS를 채워야 실제로 발송된다.
# 그 외(비어있음 포함)에는 항상 MockMailSender(콘솔 로그만 남김)를 사용한다.
# NODE_ENV/PETLOG_ENV(운영 배포 여부)와는 무관한 별도 스위치 — 로컬 개발 중에도 SES로
# 실제 발송 테스트가 가능하다. SES 샌드박스 모드에서는 발신/수신 주소 모두 AWS 콘솔에서
# 사전 검증(Verified Identity)해야 한다.
MAIL_PROVIDER=mock
MAIL_FROM_ADDRESS=

# 푸시 알림 (Firebase Cloud Messaging)
# 셋 중 하나라도 비어있으면 항상 MockPushSender(콘솔 로그만 남김)를 사용한다 — 로컬 개발 기본값.
# 실제 발송을 테스트하려면 Firebase 콘솔 > 프로젝트 설정 > 서비스 계정에서 발급한
# 비공개 키(JSON)의 project_id/client_email/private_key 값을 채운다.
# FIREBASE_PRIVATE_KEY는 개행이 포함된 문자열이므로 .env에는 \n으로 이스케이프해 한 줄로 저장한다.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 배포용 (npm run deploy 시 ECR 리포지토리 이름 결정에 사용 — petlog-backend-{PETLOG_ENV}).
# 로컬 개발에는 불필요하고, AWS 계정 ID는 여기 두지 않는다 — docker:login/docker:push 스크립트가
# `aws sts get-caller-identity`로 매번 동적으로 조회한다.
PETLOG_ENV=dev
