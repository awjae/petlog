# 백엔드 API 베이스 URL (setGlobalPrefix('api') 포함)
# Next.js rewrite의 목적지로만 사용됨 — 브라우저 코드에서 직접 참조하지 않는다
# 브라우저 → /api/... → Next.js rewrite → NEXT_PUBLIC_API_URL/...
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# 백엔드 없이 개발할 때 true로 설정 (실제 백엔드 연결 시 false 또는 제거)
NEXT_PUBLIC_USE_MOCK=false

# next/image가 허용할 이미지 호스트 (CloudFront 배포 도메인, 스킴 없이 호스트명만).
# backend/.env.example의 AWS_CLOUDFRONT_DOMAIN과 동일한 값을 사용한다.
AWS_CLOUDFRONT_DOMAIN=

# Sentry는 로컬에서 쓰지 않는다 — 실제 배포용 DSN은 여기가 아니라 .env.deploy
# (.env.deploy.example 참고)에 둔다. next dev/build/start가 .env.local은 항상
# 자동으로 읽어들이므로, 여기 두면 로컬 개발 서버에도 그대로 로드된다.

# 배포용 (npm run deploy 시 ECR 리포지토리 이름/리전 결정에 사용 — petlog-frontend-{PETLOG_ENV}).
# 로컬 개발에는 불필요하고, AWS 계정 ID는 여기 두지 않는다 — docker:login/docker:push 스크립트가
# `aws sts get-caller-identity`로 매번 동적으로 조회한다. 시크릿이 아니라서 (.claude/docs/
# decisions/018-deploy-script-consolidation.md 결정대로) .env.deploy가 아닌 여기 남아있다.
AWS_REGION=ap-northeast-2
PETLOG_ENV=dev

# AWS 자격 증명 / Sentry 실제 값은 .env.deploy.example을 참고한다 (cp .env.deploy.example
# .env.deploy). .env.local에는 실제 시크릿을 두지 않는다.
