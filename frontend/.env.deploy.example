# npm run deploy 체인(deploy:check-version/ecr-login/ecr-push/ecs-force-redeploy)이
# dotenv -e .env.deploy로 읽는 값. cp .env.deploy.example .env.deploy 로 시작한다.
#
# .env.local과 분리한 이유: .env.local은 next dev/build/start가 항상 자동으로 읽어들이는
# 파일이라, 여기 실제 시크릿을 두면 로컬 개발 서버 프로세스에도 그대로 로드된다.

# AWS 자격 증명 — 값은 반드시 본인이 직접 입력하고 채팅/AI 도구에는 절대 붙여넣지 않는다.
# aws configure --profile petlog로 ~/.aws/credentials(레포 밖)에 저장하고 여기는 비워두는
# 방식을 권장한다 (그러면 이 파일 자체가 시크릿이 되지 않는다).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Sentry — 아래 4개(NEXT_PUBLIC_SENTRY_DSN/SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN)는
# deploy:build가 dotenv로 읽어 docker build --build-arg로 넘긴다(next build 시점에 클라이언트
# 번들/서버 설정에 인라인됨). 이 파일에 값을 채워두면 npm run deploy --workspace=frontend
# 실행만으로 자동 반영된다.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Next.js 서버(SSR)/edge 런타임용 SENTRY_DSN은 여기 두지 않는다 — docker build가 아니라
# cdktf deploy가 읽는 런타임 환경변수라 infra/.env의 TF_VAR_frontend_sentry_dsn으로 관리한다
# (이 파일에 두면 어차피 deploy:build/docker build 어디에서도 읽지 않아 값이 두 곳에서
# 따로 관리되는 문제만 생긴다).
