# npm run deploy 체인(deploy:check-version/ecr-login/ecr-push/ecs-force-redeploy)이
# dotenv -e .env.deploy로 읽는 값. cp .env.deploy.example .env.deploy 로 시작한다.
#
# .env.local과 분리한 이유: .env.local은 next dev/build/start가 항상 자동으로 읽어들이는
# 파일이라, 여기 실제 시크릿을 두면 로컬 개발 서버 프로세스에도 그대로 로드된다.

# AWS 자격 증명 — 값은 반드시 본인이 직접 입력하고 채팅/AI 도구에는 절대 붙여넣지 않는다.
# aws configure --profile petlog로 ~/.aws/credentials(레포 밖)에 저장하고 여기는 비워두는
# 방식을 권장한다 (그러면 이 파일 자체가 시크릿이 되지 않는다).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Sentry — 아직 배포 파이프라인에 실제로 연결돼 있지 않다 (deploy:build build-arg 전달 +
# infra/stacks/frontend-stack.ts ECS task definition 런타임 env 주입이 별도로 필요).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
