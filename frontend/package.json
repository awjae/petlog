{
  "name": "@petlog/frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "generate": "graphql-codegen --config codegen.ts",
    "generate:watch": "graphql-codegen --config codegen.ts --watch",
    "docker:build": "docker build -f Dockerfile --build-arg NEXT_PUBLIC_API_URL=\"$NEXT_PUBLIC_API_URL\" -t petlog-frontend ..",
    "docker:push": "docker tag petlog-frontend:latest 095256592046.dkr.ecr.ap-northeast-2.amazonaws.com/petlog-frontend-dev:latest && docker push 095256592046.dkr.ecr.ap-northeast-2.amazonaws.com/petlog-frontend-dev:latest",
    "docker:deploy": "npm run docker:build && npm run docker:push"
  },
  "dependencies": {
    "@apollo/client": "^4.2.3",
    "@sentry/nextjs": "^10.63.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "msw": "^2.14.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
